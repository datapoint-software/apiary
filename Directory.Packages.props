<Project>
  <PropertyGroup>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup Label="Analyzers">
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.320" />
    <PackageVersion Include="Roslynator.Analyzers" Version="5.0.1" />
    <PackageVersion Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.12.1" />
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
  </ItemGroup>
  <ItemGroup Label="Runtime">
    <PackageVersion Include="Datapoint.Mediator" Version="4.0.0-beta.3" />
    <PackageVersion Include="Datapoint.Mediator.Abstractions" Version="4.0.0-beta.3" />
    <PackageVersion Include="Datapoint.Mediator.DependencyInjection" Version="4.0.0-beta.3" />
    <PackageVersion Include="Datapoint.Mediator.AspNetCore" Version="4.0.0-beta.3" />
    <PackageVersion Include="Datapoint.Mediator.Authorization" Version="4.0.0-beta.3" />
    <PackageVersion Include="Datapoint.Mediator.Authorization.DependencyInjection" Version="4.0.0-beta.3" />
    <PackageVersion Include="Datapoint.Mediator.Authorization.AspNetCore" Version="4.0.0-beta.3" />
    <PackageVersion Include="Datapoint.Mediator.FluentValidation" Version="4.0.0-beta.3" />
    <PackageVersion Include="Datapoint.Mediator.FluentValidation.DependencyInjection" Version="4.0.0-beta.3" />
    <PackageVersion Include="Datapoint.Mediator.ModelContextProtocol" Version="4.0.0-beta.3" />
    <PackageVersion Include="Datapoint.Mediator.CommandLine" Version="4.0.0-beta.3" />
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />
    <PackageVersion Include="DotNext.Net.Cluster" Version="6.11.1" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.20.1-beta.1" />
  </ItemGroup>
  <ItemGroup Label="Tests">
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
  </ItemGroup>
</Project>
